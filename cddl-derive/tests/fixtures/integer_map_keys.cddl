integer-key-record = {
  ? 1 => int,
  ? 4 => bstr,
}

mixed-integer-keys = {
  -1 => tdate,
  ? 2 => bstr,
  ? 3 => int / null,
  * tstr => tstr,
}
integer-map-choice = { ? 1 => int } / tstr
recursive-key-node = { ? child: recursive-key-node, * tstr => int }
value = int
literal-value = { 1 => value }
container-values = { 2 => [* value] }
